{
    "image": "ghcr.io/imgproxy/imgproxy-base:v4.0.6",
    "name": "imgproxy OSS",
    "portsAttributes": {
        "8081": {
            "label": "imgproxy",
            "onAutoForward": "notify"
        },
        "8091": {
            "label": "Prometheus metrics",
            "onAutoForward": "silent"
        },
        "8071": {
            "label": "Utilities (pprof, etc.)",
            "onAutoForward": "silent"
        }
    },
    "containerEnv": {
        "PORT": "8081",
        "IMGPROXY_PROMETHEUS_BIND": ":8091",
        "IMGPROXY_LOCAL_FILESYSTEM_ROOT": "/images",
        "IMGPROXY_ENABLE_VIDEO_THUMBNAILS": "true",
        "IMGPROXY_MAX_ANIMATION_FRAMES": "999",
        "IMGPROXY_VIPS_LEAK_CHECK": "true",
        "IMGPROXY_LOG_MEM_STATS": "true",
        "IMGPROXY_DEVELOPMENT_ERRORS_MODE": "true",
        "HISTFILE": "/root/.cache/.bash_history"
    },
    "mounts": [
        {
            "source": "${localWorkspaceFolder}/.devcontainer/images",
            "target": "/images",
            "type": "bind"
        },
        // devcontainer syntax doesn't support volume-subpath option when specified as an object,
        // we have to use string syntax instead. These definitions are used in bin/ scripts so keep them
        // as strings, please.
        "source=imgproxy-cache,target=/root/.cache,type=volume,volume-subpath=cache",
        "source=imgproxy-cache,target=/root/go/pkg/mod,type=volume,volume-subpath=go-mod"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "ms-vscode.cpptools"
            ]
        }
    },
    "postCreateCommand": "go tool lefthook install",
    "initializeCommand": {
        // volume-subpaths must be created before volume is mounted, hence we need to call mkdir.
        // guard_docker (in .runrc) needs the same volumes, so this is a ./run task
        // (bin/create-cache-volumes.sh) rather than a one-off command defined here.
        "createCacheVolume": "${localWorkspaceFolder}/run create-cache-volumes",
        "linkImagesDir": "if [ ! -e ${localWorkspaceFolder}/.devcontainer/images ] && [ ! -L ${localWorkspaceFolder}/.devcontainer/images ]; then ln -s ${localWorkspaceFolder}/testdata/test-images ${localWorkspaceFolder}/.devcontainer/images; fi"
    }
}
